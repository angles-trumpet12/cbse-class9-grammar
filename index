        function flagPeerDoubtMessage(doubtId, replyIndex = null) {
            const item = peerDoubts.find(d => d.id === doubtId);
            if (!item) return;

            let targetText = replyIndex !== null ? item.replies[replyIndex]?.text : item.question;
            
            // AI safety check simulation
            const isHarmful = /abuse|hate|violence|kill|threat|idiot|stupid|badword/i.test(targetText);

            if (isHarmful) {
                if (replyIndex !== null) {
                    item.replies.splice(replyIndex, 1);
                } else {
                    peerDoubts = peerDoubts.filter(d => d.id !== doubtId);
                }
                localStorage.setItem('gramble_peer_doubts', JSON.stringify(peerDoubts));
                alert("🚩 AI Safety Moderator Notice:\nThis message contained inappropriate language and was automatically purged from the public board.");
