        function drawSvgConnections() {
            const svg = document.getElementById('svgLines');
            const container = document.getElementById('mindmapView');
            if (!svg || !container) return;

            svg.innerHTML = '';
            const containerRect = container.getBoundingClientRect();

            const rootNode = document.getElementById('root-node');
            if (!rootNode) return;
            const rootRect = rootNode.getBoundingClientRect();

            const startX = rootRect.right - containerRect.left + container.scrollLeft;
            const startY = rootRect.top + rootRect.height / 2 - containerRect.top + container.scrollTop;

            const chapter = grammarData[currentChapterKey] || grammarData.tenses;
            chapter.nodes.forEach((cat, catIdx) => {
                const catBox = document.getElementById(`cat-${catIdx}`);
                if (!catBox) return;

                const catRect = catBox.getBoundingClientRect();
                const catStartX = catRect.left - containerRect.left + container.scrollLeft;
                const catStartY = catRect.top + catRect.height / 2 - containerRect.top + container.scrollTop;

                drawCurvedLine(svg, startX, startY, catStartX, catStartY, '#ff2a85', 3);

                const catEndX = catRect.right - containerRect.left + container.scrollLeft;
                cat.children.forEach((child, childIdx) => {
                    const leafNode = document.getElementById(`leaf-${catIdx}-${childIdx}`);
                    if (!leafNode) return;

                    const leafRect = leafNode.getBoundingClientRect();
                    const leafStartX = leafRect.left - containerRect.left + container.scrollLeft;
                    const leafStartY = leafRect.top + leafRect.height / 2 - containerRect.top + container.scrollTop;

                    drawCurvedLine(svg, catEndX, catStartY, leafStartX, leafStartY, '#8b5cf6', 2);
                });
            });
        }

        function drawCurvedLine(svg, x1, y1, x2, y2, color, strokeWidth) {
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            const dx = (x2 - x1) * 0.5;
            const d = `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
            
            path.setAttribute('d', d);
            path.setAttribute('stroke', color);
            path.setAttribute('stroke-width', strokeWidth);
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke-linecap', 'round');
            path.setAttribute('opacity', '0.8');
            svg.appendChild(path);
        }

