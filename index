<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 selection:bg-pink-500 selection:text-white">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBSE Class 9 Grammar Master Hub & Gramble AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        vibrant: {
                            pink: '#ff2a85',
                            purple: '#8b5cf6',
                            cyan: '#06b6d4',
                            amber: '#f59e0b',
                            emerald: '#10b981',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.4); border-radius: 999px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(236, 72, 153, 0.7); }

        .glass-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .neon-glow-pink { box-shadow: 0 0 25px rgba(255, 42, 133, 0.35); }
        .neon-glow-purple { box-shadow: 0 0 25px rgba(139, 92, 246, 0.35); }
        .neon-glow-cyan { box-shadow: 0 0 25px rgba(6, 182, 212, 0.35); }
        .neon-glow-amber { box-shadow: 0 0 25px rgba(245, 158, 11, 0.35); }

        @keyframes floatBot {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(2deg); }
        }
        .animate-float-bot { animation: floatBot 4s ease-in-out infinite; }

        @keyframes floatMail {
            0%, 100% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-6px) scale(1.03); }
        }
        .animate-float-mail { animation: floatMail 3.5s ease-in-out infinite; }

        @keyframes earWiggle {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-8deg); }
            75% { transform: rotate(8deg); }
        }
        .wiggle-ears { animation: earWiggle 2s ease-in-out infinite; }

        .mindmap-node-vibrant {
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .mindmap-node-vibrant:hover {
            transform: scale(1.02) translateY(-4px);
        }

        .chat-bubble-user {
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            color: #ffffff;
            border-bottom-right-radius: 2px;
        }
        .chat-bubble-ai {
            background: rgba(30, 41, 59, 0.9);
            color: #f8fafc;
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-bottom-left-radius: 2px;
        }
    </style>
</head>
<body class="h-full text-slate-100 font-sans flex flex-col bg-slate-950 antialiased relative overflow-x-hidden">

    <header class="bg-slate-900/90 border-b border-slate-800 sticky top-0 z-30 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo with Gramble Mini Avatar -->
                <div class="flex items-center space-x-3">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-pink-500 via-purple-600 to-cyan-400 p-0.5 shadow-lg shadow-purple-500/30 flex items-center justify-center animate-pulse">
                        <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center overflow-hidden">
                            <svg class="w-8 h-8" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="42" fill="#0f172a" stroke="#8b5cf6" stroke-width="4"/>
                                <circle cx="35" cy="42" r="7" fill="#ff2a85"/>
                                <circle cx="65" cy="42" r="7" fill="#ff2a85"/>
                                <circle cx="37" cy="40" r="2.5" fill="#ffffff"/>
                                <circle cx="67" cy="40" r="2.5" fill="#ffffff"/>
                                <path d="M 38 62 Q 50 74 62 62" fill="none" stroke="#06b6d4" stroke-width="4" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>
                    <div>
                        <h1 class="font-display font-extrabold text-lg sm:text-xl text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400">Gramble AI Master Hub</h1>
                        <p class="text-xs text-slate-400 font-medium hidden sm:block">Grade 9 CBSE English • Mind Maps • 300+ Qs • Anonymous Peer Doubts Mail</p>
                    </div>
                </div>

                <!-- Main View Navigation Controls -->
                <div class="flex items-center space-x-2">
                    <button id="navBtnMindmap" onclick="switchMainView('mindmap')" class="px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition-all bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-lg shadow-pink-500/25">
                        <i class="fa-solid fa-sitemap"></i> <span class="hidden sm:inline">Vibrant Mind Maps</span>
                    </button>

                    <button id="navBtnVideos" onclick="switchMainView('videos')" class="px-3.5 py-1.5 rounded-xl border border-slate-700 text-slate-300 hover:bg-slate-800 text-xs sm:text-sm font-bold flex items-center gap-2 transition-all">
                        <i class="fa-solid fa-clapperboard text-cyan-400"></i> <span class="hidden sm:inline">AI Video Clips</span>
                    </button>
                    
                    <button id="navBtnPractice" onclick="switchMainView('quiz')" class="px-3.5 py-1.5 rounded-xl border border-slate-700 text-slate-300 hover:bg-slate-800 text-xs sm:text-sm font-bold flex items-center gap-2 transition-all">
                        <i class="fa-solid fa-gamepad text-pink-400"></i> <span>Practice (300+)</span>
                    </button>

                    <button id="navBtnMock" onclick="startMockTest()" class="px-3 py-1.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 hover:bg-amber-500/20 text-xs sm:text-sm font-bold flex items-center gap-1.5 transition-all">
                        <i class="fa-solid fa-stopwatch text-amber-400"></i> <span class="hidden md:inline">Mock Test</span>
                    </button>

                    <button onclick="openCheatSheetModal()" class="p-2 rounded-xl bg-purple-500/10 border border-purple-500/30 text-purple-300 hover:bg-purple-500/20 text-xs sm:text-sm font-bold flex items-center transition-all" title="Formula Cheat Sheet">
                        <i class="fa-solid fa-bolt text-purple-400"></i>
                    </button>
                </div>
            </div>

            <!-- Chapter Selection Tabs -->
            <div class="flex space-x-2 overflow-x-auto pb-2 pt-1 custom-scrollbar border-t border-slate-800">
                <button onclick="switchChapter('all')" id="tab-all" class="chapter-tab px-3 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap transition-all text-slate-400 hover:text-white hover:bg-slate-800">
                    <i class="fa-solid fa-globe"></i> All Topics
                </button>
                <button onclick="switchChapter('tenses')" id="tab-tenses" class="chapter-tab active px-3.5 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-md">
                    <i class="fa-solid fa-clock"></i> 1. Tenses
                </button>
                <button onclick="switchChapter('clauses')" id="tab-clauses" class="chapter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 text-slate-400 hover:text-white hover:bg-slate-800">
                    <i class="fa-solid fa-diagram-project"></i> 2. Clauses
                </button>
                <button onclick="switchChapter('determiners')" id="tab-determiners" class="chapter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 text-slate-400 hover:text-white hover:bg-slate-800">
                    <i class="fa-solid fa-list-check"></i> 3. Determiners
                </button>
                <button onclick="switchChapter('reported')" id="tab-reported" class="chapter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 text-slate-400 hover:text-white hover:bg-slate-800">
                    <i class="fa-solid fa-comments"></i> 4. Reported Speech
                </button>
                <button onclick="switchChapter('modals')" id="tab-modals" class="chapter-tab px-3.5 py-1.5 rounded-lg text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 text-slate-400 hover:text-white hover:bg-slate-800">
                    <i class="fa-solid fa-shield-halved"></i> 5. Modals
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-5 flex flex-col gap-4 overflow-hidden">

        <!-- Top Controls & Search Bar -->
        <div class="glass-card p-3 sm:p-4 rounded-2xl shadow-xl flex flex-wrap items-center justify-between gap-3">
            
            <!-- Activity Type Filters (Visible in Practice Mode) -->
            <div id="quizTypeFilterBar" class="hidden flex flex-wrap items-center gap-1.5 text-xs">
                <span class="text-slate-400 font-bold uppercase text-[10px] mr-1">Activity:</span>
                <button onclick="setQuizTypeFilter('all')" id="qtype-all" class="qtype-btn active px-2.5 py-1 rounded-lg bg-pink-500 text-white font-bold">All Types</button>
                <button onclick="setQuizTypeFilter('mcq')" id="qtype-mcq" class="qtype-btn px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 font-bold">MCQs</button>
                <button onclick="setQuizTypeFilter('blank')" id="qtype-blank" class="qtype-btn px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 font-bold">Fill Blanks</button>
                <button onclick="setQuizTypeFilter('rewrite')" id="qtype-rewrite" class="qtype-btn px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 font-bold">Rewriting</button>
            </div>

            <!-- Difficulty Filters -->
            <div id="quizDiffFilterBar" class="hidden flex items-center gap-1.5 text-xs">
                <span class="text-slate-400 font-bold uppercase text-[10px] mr-1">Level:</span>
                <button onclick="setDiffFilter('all')" id="diff-all" class="diff-btn active px-2.5 py-1 rounded-lg bg-slate-700 text-white font-bold">All</button>
                <button onclick="setDiffFilter('easy')" id="diff-easy" class="diff-btn px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold">Easy</button>
                <button onclick="setDiffFilter('medium')" id="diff-medium" class="diff-btn px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/30 font-bold">Medium</button>
                <button onclick="setDiffFilter('hard')" id="diff-hard" class="diff-btn px-2.5 py-1 rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/30 font-bold">Hard</button>
            </div>

            <!-- Mind Map Legend -->
            <div id="mindmapLegend" class="flex items-center gap-3 text-xs font-semibold">
                <span class="text-slate-400 uppercase tracking-wider text-[10px]">Neon Nodes:</span>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 text-[11px]">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Formula
                </span>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 text-[11px]">
                    <span class="w-2 h-2 rounded-full bg-cyan-400"></span> 4–5 CBSE Examples
                </span>
            </div>

            <!-- Global Search Field -->
            <div class="relative flex-1 sm:flex-initial sm:min-w-[220px]">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="searchInput" oninput="handleSearch()" placeholder="Search concepts, rules, questions..." class="w-full pl-8 pr-3 py-1.5 text-xs rounded-xl border border-slate-700 bg-slate-900/90 text-white focus:outline-none focus:ring-2 focus:ring-pink-500/40 focus:border-pink-500">
            </div>
        </div>

        <!-- VIEW 1: SUPER VIBRANT MIND MAPS -->
        <div id="mindmapView" class="flex-1 glass-card rounded-2xl border border-slate-800 p-4 sm:p-6 overflow-auto relative custom-scrollbar min-h-[560px] neon-glow-purple">
            <svg id="svgLines" class="absolute inset-0 w-full h-full pointer-events-none z-0 min-w-[1050px] min-h-[650px]"></svg>
            <div id="mindmapTree" class="relative z-10 min-w-[1000px] flex justify-start items-center py-4"></div>
        </div>

        <!-- VIEW 2: STANDALONE NATIVE AI ANIMATED VIDEO MINI-LESSONS -->
        <div id="videosView" class="hidden flex-1 glass-card rounded-2xl border border-slate-800 p-4 sm:p-6 shadow-2xl overflow-y-auto custom-scrollbar space-y-6">
            <div class="border-b border-slate-800 pb-4 flex flex-wrap justify-between items-center gap-4">
                <div>
                    <span class="text-[10px] font-extrabold uppercase tracking-widest text-cyan-400 px-2.5 py-1 bg-cyan-500/10 rounded-md border border-cyan-500/20">Native Web Animation & Voice Engine</span>
                    <h2 class="font-display font-extrabold text-2xl text-white mt-1 flex items-center gap-2">
                        <i class="fa-solid fa-film text-pink-400"></i> Gramble AI 30-Second Video Lessons
                    </h2>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-400 font-bold">Select Topic:</span>
                    <select id="videoTopicSelect" onchange="loadNativeVideoTopic(this.value)" class="bg-slate-900 border border-slate-700 text-xs font-bold rounded-xl px-3 py-2 text-pink-300 focus:outline-none focus:ring-2 focus:ring-pink-500/40">
                        <option value="tenses">1. Tenses Timeline Lesson</option>
                        <option value="clauses">2. Clause Identifier Engine</option>
                        <option value="determiners">3. Quantifier & Article Matrix</option>
                        <option value="reported">4. Reported Speech Tense Shifts</option>
                        <option value="modals">5. Modals Duty & Probability Meter</option>
                    </select>
                </div>
            </div>

            <!-- Canvas Video Player -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 bg-slate-950 rounded-2xl border border-slate-800 p-4 space-y-3 relative shadow-2xl neon-glow-cyan">
                    <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
                        <span id="canvasPlayerTitle" class="text-xs font-bold text-slate-300 font-mono">GrambleStudio_Lesson1_Tenses.anim</span>
                        <span id="videoTimeDisplay" class="text-xs font-mono text-cyan-400 font-bold">00:00 / 00:30</span>
                    </div>

                    <div class="relative aspect-video w-full bg-slate-900/90 rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
                        <canvas id="grammarVideoCanvas" width="800" height="450" class="w-full h-full object-contain"></canvas>
                        <div id="videoCCBox" class="absolute bottom-3 left-4 right-4 bg-slate-950/85 backdrop-blur-md border border-slate-800 p-2.5 rounded-xl text-center text-xs font-semibold text-pink-300 shadow-lg">
                            "Welcome to Gramble AI's 30-Second Mini Lesson!"
                        </div>
                    </div>

                    <div class="space-y-2 pt-1">
                        <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden cursor-pointer">
                            <div id="videoProgressBar" class="h-full bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-400 w-0 transition-all"></div>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <button id="playVideoBtn" onclick="toggleNativeVideoPlay()" class="w-10 h-10 rounded-xl bg-gradient-to-tr from-pink-500 to-purple-600 text-white flex items-center justify-center font-bold shadow-lg">
                                    <i id="playIcon" class="fa-solid fa-play"></i>
                                </button>
                                <button onclick="restartNativeVideo()" class="w-9 h-9 rounded-xl bg-slate-800 text-slate-300 flex items-center justify-center text-xs">
                                    <i class="fa-solid fa-rotate-left"></i>
                                </button>
                                <button onclick="toggleVideoVoiceMute()" class="w-9 h-9 rounded-xl bg-slate-800 text-cyan-400 flex items-center justify-center text-xs">
                                    <i id="muteIcon" class="fa-solid fa-volume-high"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gradient-to-b from-slate-900 to-slate-950 rounded-2xl border border-slate-800 p-5 flex flex-col items-center text-center justify-between shadow-xl">
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-pink-500/20 text-pink-300">Gramble Mascot Narrator</span>
                    <div class="my-4 animate-float-bot">
                        <svg class="w-44 h-44" viewBox="0 0 200 200">
                            <rect class="wiggle-ears" x="15" y="70" width="20" height="35" rx="10" fill="#ec4899" />
                            <rect class="wiggle-ears" x="165" y="70" width="20" height="35" rx="10" fill="#ec4899" />
                            <rect x="30" y="30" width="140" height="120" rx="36" fill="#0f172a" stroke="#8b5cf6" stroke-width="6"/>
                            <rect x="48" y="52" width="104" height="68" rx="20" fill="#020617"/>
                            <ellipse cx="72" cy="80" rx="12" ry="15" fill="#06b6d4"/>
                            <ellipse cx="128" cy="80" rx="12" ry="15" fill="#06b6d4"/>
                            <circle cx="68" cy="74" r="5" fill="#ffffff"/>
                            <circle cx="124" cy="74" r="5" fill="#ffffff"/>
                            <path d="M 82 98 Q 100 112 118 98" fill="none" stroke="#ff2a85" stroke-width="5" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <p class="text-xs text-slate-300">"Press play to start narration audio!"</p>
                </div>
            </div>
        </div>

        <!-- VIEW 3: PRACTICE QUESTION BANK -->
        <div id="quizView" class="hidden flex-1 glass-card rounded-2xl border border-slate-800 p-4 sm:p-6 shadow-2xl overflow-y-auto custom-scrollbar">
            <div class="max-w-4xl mx-auto space-y-5">
                <div class="bg-gradient-to-r from-slate-950 via-purple-950 to-slate-950 text-white rounded-2xl p-5 border border-purple-500/30 shadow-xl">
                    <div class="flex flex-wrap justify-between items-center gap-4">
                        <div>
                            <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-md bg-purple-500/20 text-purple-300">CBSE Practice Bank</span>
                            <h2 id="quizTitle" class="font-display font-extrabold text-xl sm:text-2xl mt-1 text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-cyan-400">300+ Question Exam Suite</h2>
                        </div>
                        <div class="grid grid-cols-3 gap-3 text-center">
                            <div class="bg-slate-900/80 border border-slate-800 px-3.5 py-2 rounded-xl">
                                <div class="text-[9px] uppercase tracking-wider text-pink-400 font-bold">Answered</div>
                                <div id="statAttempted" class="font-extrabold text-base text-white">0 / 0</div>
                            </div>
                            <div class="bg-slate-900/80 border border-slate-800 px-3.5 py-2 rounded-xl">
                                <div class="text-[9px] uppercase tracking-wider text-cyan-400 font-bold">Accuracy</div>
                                <div id="statAccuracy" class="font-extrabold text-base text-emerald-400">0%</div>
                            </div>
                            <div class="bg-slate-900/80 border border-slate-800 px-3.5 py-2 rounded-xl">
                                <div class="text-[9px] uppercase tracking-wider text-amber-400 font-bold">Score</div>
                                <div id="statScore" class="font-extrabold text-base text-amber-300">0 pts</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="quizContainer" class="space-y-4"></div>

                <div class="pt-4 flex flex-wrap justify-between items-center gap-3 border-t border-slate-800">
                    <button onclick="resetQuizProgress()" class="px-3.5 py-2 bg-slate-800 text-slate-300 rounded-xl text-xs font-bold">Clear Answers</button>
                    <div class="flex items-center gap-2">
                        <span id="paginationText" class="text-xs text-slate-400 font-bold">Page 1 of 1</span>
                        <button id="prevPageBtn" onclick="changePage(-1)" class="p-2 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 text-xs"><i class="fa-solid fa-chevron-left"></i></button>
                        <button id="nextPageBtn" onclick="changePage(1)" class="p-2 rounded-xl border border-slate-700 bg-slate-900 text-slate-300 text-xs"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- FLOATING DOCK AT BOTTOM RIGHT (Gramble AI Assistant + Mail Envelope Hub) -->
    <div id="floatingDock" class="fixed bottom-5 right-5 z-50 flex items-center gap-3">
        
        <!-- 1. FLOATING ENVELOPE WIDGET BUTTON (ANONYMOUS PEER DOUBTS) -->
        <div class="relative animate-float-mail">
            <button onclick="openPeerMailModal()" class="w-14 h-14 rounded-full bg-gradient-to-tr from-amber-500 via-orange-500 to-amber-300 text-slate-950 shadow-2xl hover:scale-110 transition-all flex items-center justify-center border-2 border-slate-900 neon-glow-amber group" title="Open Anonymous Peer Doubt Mail Box">
                <!-- Cute SVG Animated Envelope -->
                <svg class="w-8 h-8 text-slate-950 group-hover:rotate-12 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <!-- Glowing Unread Count Badge -->
                <span id="unreadMailBadge" class="absolute -top-1 -right-1 bg-rose-500 text-white font-black text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-slate-950 animate-bounce">
                    3
                </span>
            </button>
        </div>

        <!-- 2. FLOATING GRAMBLE AI CHATBOT WIDGET BUTTON -->
        <div class="relative">
            <button onclick="toggleChatWidget()" class="w-14 h-14 rounded-full bg-gradient-to-tr from-pink-500 via-purple-600 to-cyan-400 text-white shadow-2xl hover:scale-110 transition-all flex items-center justify-center border-2 border-slate-900 neon-glow-pink" title="Ask Gramble AI Assistant">
                <svg class="w-9 h-9" viewBox="0 0 100 100">
