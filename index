        function generateGrambleAiResponse(prompt) {
            const q = prompt.toLowerCase();
            if (q.includes('reported speech') || q.includes('indirect')) {
                return "In Reported Speech, if the reporting verb is in the past (e.g., 'said'), backshift tenses: Simple Present ➔ Simple Past, Present Continuous ➔ Past Continuous! <em>Note: Universal facts never change tense!</em>";
            } else if (q.includes('few') || q.includes('a few')) {
                return "<strong>Few vs A Few:</strong><br>• <em>'Few'</em> = negative meaning (hardly any, almost none).<br>• <em>'A few'</em> = positive meaning (a small number/some). Both are for plural countable nouns!";
            } else if (q.includes('tense') || q.includes('past perfect')) {
                return "<strong>Past Perfect vs Simple Past:</strong> When two actions happened in the past, the earlier event takes <em>Past Perfect (had + V3)</em>, and the later event takes <em>Simple Past (V2)</em>!";
            } else if (q.includes('clause') || q.includes('noun clause')) {
                return "<strong>Noun Clauses:</strong> Ask 'WHAT?' after the main verb! If the subordinate clause answers 'WHAT?', it's a Noun Clause functioning as an Object or Subject.";
            } else if (q.includes('modal') || q.includes('must') || q.includes('should')) {
                return "<strong>Must vs Should:</strong> Use <em>'Must'</em> for mandatory legal/official rules with no choice, and <em>'Should'</em> for moral advice or recommendations!";
            }
            return "Great question! Remember to check the formula cards in our Mind Map tab or test your knowledge in the Practice Bank!";
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
