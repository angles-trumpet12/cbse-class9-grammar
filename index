            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3 shadow-lg relative";

                let repliesHTML = item.replies.map((rep, repIdx) => `
                    <div class="bg-slate-950/80 border border-slate-800 p-3 rounded-xl space-y-1 mt-2 text-xs">
                        <div class="flex justify-between items-center text-[10px] text-slate-400 font-mono">
                            <span class="text-pink-400 font-bold"><i class="fa-solid fa-user-graduate mr-1"></i>${rep.author}</span>
                            <button onclick="flagPeerDoubtMessage(${item.id}, ${repIdx})" class="text-slate-500 hover:text-rose-400 transition-all" title="Flag as inappropriate for AI safety recheck">
                                🚩 Flag
                            </button>
                        </div>
                        <p class="text-slate-200 mt-1">${escapeHTML(rep.text)}</p>
                    </div>
                `).join('');

                card.innerHTML = `
                    <div class="flex justify-between items-center text-xs font-mono">
                        <div class="flex items-center gap-2">
                            <span class="text-amber-400 font-bold"><i class="fa-solid fa-user-secret mr-1"></i>${item.author}</span>
                            <span class="text-[9px] px-2 py-0.5 rounded-md bg-slate-800 text-cyan-300 font-bold uppercase">${item.topic}</span>
                        </div>
                        <div class="flex items-center gap-2 text-[10px] text-slate-400">
                            <span>${item.time}</span>
                            <button onclick="flagPeerDoubtMessage(${item.id})" class="text-slate-500 hover:text-rose-400 transition-all" title="Flag doubt for AI safety recheck">
                                🚩
                            </button>
                        </div>
                    </div>

                    <div class="font-medium text-slate-100 text-xs sm:text-sm leading-relaxed">${escapeHTML(item.question)}</div>

                    <div class="flex items-center gap-3 pt-1 border-t border-slate-800/80 text-xs">
                        <button onclick="upvoteDoubt(${item.id})" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-amber-500/20 text-amber-300 font-bold flex items-center gap-1 transition-all text-[11px]">
                            <i class="fa-solid fa-thumbs-up"></i> Helpful (${item.upvotes})
                        </button>
                        <span class="text-slate-500 text-[11px] font-mono"><i class="fa-solid fa-comments mr-1"></i>${item.replies.length} Replies</span>
                    </div>

                    <div class="space-y-2 pt-2 border-t border-slate-800/60">
                        ${repliesHTML}
                        
                        <div class="flex gap-2 pt-1">
                            <input type="text" id="reply-input-${item.id}" placeholder="Write an anonymous solution..." class="flex-1 bg-slate-950 border border-slate-800 px-3 py-1.5 rounded-xl text-xs text-white focus:outline-none">
                            <button onclick="submitPeerReply(${item.id})" class="px-3 py-1.5 bg-amber-500 text-slate-950 font-bold rounded-xl text-xs hover:bg-amber-400 transition-all">Reply</button>
                        </div>
                    </div>
                `;

                container.appendChild(card);
            });
        }

        window.onload = function() {
            renderMindMap();
            renderPeerMailFeed();
            loadNativeVideoTopic('tenses');
        };

        window.onresize = function() {
            if (activeMainView === 'mindmap') drawSvgConnections();
        };
    </script>
</body>
</html>