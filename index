                ctx.beginPath(); ctx.moveTo(60, 240); ctx.lineTo(740, 240); ctx.stroke();

                // Past, Present, Future Nodes
                ctx.fillStyle = '#ec4899';
                ctx.beginPath(); ctx.arc(180, 240, 16, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#ffffff'; ctx.font = 'bold 14px JetBrains Mono'; ctx.fillText('PAST', 160, 280);

                ctx.fillStyle = '#8b5cf6';
                ctx.beginPath(); ctx.arc(400, 240, 16, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#ffffff'; ctx.fillText('PRESENT', 370, 280);

                ctx.fillStyle = '#10b981';
                ctx.beginPath(); ctx.arc(620, 240, 16, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#ffffff'; ctx.fillText('FUTURE', 590, 280);

                // Moving pulse along timeline
                const pulseX = 60 + progressRatio * 680;
                ctx.fillStyle = '#f59e0b';
                ctx.beginPath(); ctx.arc(pulseX, 240, 12, 0, Math.PI * 2); ctx.fill();
            } else {
                // Flow Diagram Cards
                ctx.fillStyle = 'rgba(30, 41, 59, 0.8)';
                ctx.strokeStyle = '#8b5cf6';
                ctx.lineWidth = 2;
                ctx.beginPath(); ctx.roundRect(80, 140, 280, 180, 16); ctx.fill(); ctx.stroke();
                ctx.beginPath(); ctx.roundRect(440, 140, 280, 180, 16); ctx.fill(); ctx.stroke();

                ctx.fillStyle = '#06b6d4';
                ctx.font = 'bold 18px Outfit';
                ctx.fillText('RULE CONCEPT', 110, 180);
